// Decision tree for choosing the p95 method (Fig 1). Rendered by relative_error_band_decision_tree.py with Graphviz.
digraph p95_method {
  graph [rankdir=TB, splines=true, nodesep=0.55, ranksep=0.55, pad=0.3, bgcolor="white",
         fontname="Inter", newrank=true, ordering=out];
  node  [fontname="Inter", fontsize=15, penwidth=1.6, margin="0.18,0.10"];
  edge  [fontname="Inter SemiBold", fontsize=13, color="#7f7f7f", fontcolor="#555555",
         penwidth=1.6, arrowsize=0.8];

  // decisions: diamonds (flowchart convention)
  node [shape=diamond, style="filled", fillcolor="#e3eef8", color="#1f77b4", fontcolor="#1a1a1a",
        width=2.6, height=1.15, margin="0.02,0.02"];
  raw    [label=<Raw pairs<BR/>(<I>x<SUB>i</SUB></I>, <I>y<SUB>i</SUB></I>) available?>];
  normal [label=<Is <I>e<SUB>i</SUB></I><BR/>normal?>];
  mean   [label=<Is <I>μ<SUB>e</SUB></I> = 0?>];

  // results: rounded boxes, formula large, references small
  node [shape=box, style="rounded,filled", width=2.8, height=0.9, margin="0.20,0.12"];
  empirical [fillcolor="#e5f3e5", color="#2ca02c",
             label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="17"><I>p</I><SUB>95</SUB> = 0.95 quantile of |<I>e<SUB>i</SUB></I>|</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#555555">Empirical Quantile  ·  Eq. (8), (9)  ·  Sec. 4.2</FONT></TD></TR></TABLE>>];
  zero      [fillcolor="#e5f3e5", color="#2ca02c",
             label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="17"><I>p</I><SUB>95</SUB> = 1.960 RMSRE</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#555555">Normal with Zero Mean  ·  Eq. (10)  ·  Sec. 4.3</FONT></TD></TR></TABLE>>];
  nonzero   [fillcolor="#e5f3e5", color="#2ca02c",
             label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="17">Solve Eq. (11) with <I>μ<SUB>e</SUB></I>, <I>σ<SUB>e</SUB></I></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#555555">Normal with Nonzero Mean  ·  Sec. 4.4</FONT></TD></TR></TABLE>>];
  markov    [fillcolor="#fdebd9", color="#ff7f0e",
             label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="17"><I>p</I><SUB>95</SUB> ≤ RMSRE / √0.05</FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#555555">Upper bound only  ·  Eq. (12)  ·  Sec. 4.5</FONT></TD></TR></TABLE>>];

  // note for the case outside the tree
  note [shape=note, style="filled", fillcolor="#f2f2f2", color="#9e9e9e", fontsize=13, margin="0.20,0.12",
        label=<<B>Only R<SUP>2</SUP> and RMSE known:</B> <I>p</I><SUB>95</SUB> cannot be determined.<BR/>With min <I>y<SUB>i</SUB></I>: RMSRE ≤ RMSE / min <I>y<SUB>i</SUB></I>, then Eq. (12)  ·  Sec. 4.6>];

  raw    -> empirical [label="  yes  "];
  raw    -> normal    [label="  no  "];
  normal -> mean      [label="  yes  "];
  normal -> markov    [label="  no / unknown  "];
  mean   -> zero      [label="  yes  "];
  mean   -> nonzero   [label="  no  "];

  { rank=same; empirical; normal; }
  { rank=same; mean; markov; }
  { rank=same; zero; nonzero; }
  zero -> note [style=invis];
  { rank=sink; note; }
}
