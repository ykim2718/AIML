{
  "extraKnownMarketplaces": {
    "aiml": {
      "source": {
        "source": "github",
        "repo": "ykim2718/AIML"
      }
    }
  },
  "enabledPlugins": {
    "yrocket-rules@aiml": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bootstrap-plugins.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
