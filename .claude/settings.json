{
  "extraKnownMarketplaces": {
    "claude-configuration": {
      "source": {
        "source": "github",
        "repo": "ykim2718/Claude-Configuration"
      }
    }
  },
  "enabledPlugins": {
    "yrocket-md-doc@claude-configuration": true,
    "yrocket-coding@claude-configuration": true
  },
  "env": {
    "TZ": "America/Chicago"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/update-plugins.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
